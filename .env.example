# Copy to .env with `make env`, which fills the secrets with random values.
# Never commit .env. This file holds placeholders only.

# Bearer token required by every /api endpoint (minimum 32 characters).
API_TOKEN=change-me-to-a-random-value-of-at-least-32-chars

# Token mock-tools requires from the api (minimum 32 characters; not the API token).
TOOLS_API_TOKEN=change-me-to-another-random-value-of-32-chars
TOOLS_BASE_URL=http://mock-tools:8001

# PostgreSQL credentials (used by db, migrate and api).
POSTGRES_USER=companion
POSTGRES_DB=companion
POSTGRES_PASSWORD=change-me

# Serve OpenAPI docs at http://127.0.0.1:8000/docs (local demo only; default off).
ENABLE_DOCS=true

LOG_LEVEL=INFO
